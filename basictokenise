    "CHAIN" => [0xd7, $basflag_transfer_r],
    "CHR\$" => [0xbd, 0],
    "CLEAR" => [0xd8, $basflag_ignore_next],
    "CLOSE" => [0xd9, $basflag_transfer_r + $basflag_ignore_next],
    "CLG" => [0xda, $basflag_ignore_next],
    "CLS" => [0xdb, $basflag_ignore_next],
    "COS" => [0x9b, 0],
    "COUNT" => [0x9c, $basflag_ignore_next],
