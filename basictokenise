    "REPORT" => [0xf6, $basflag_ignore_next],
    "READ" => [0xf3, $basflag_transfer_r],
    "REM" => [0xf4, $basflag_giveup],
    "RUN" => [0xf9, $basflag_ignore_next],
    "RAD" => [0xb2, 0],
